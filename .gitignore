# Secrets - never commit credentials
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Tooling caches and reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OpenAPI generation workspace (scripts/bootstrap_client.sh)
tmp/

# Editors: share only the project's MCP config and recommended extensions
.vscode/*
!.vscode/mcp.json
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Third-party documents that must not be redistributed (e.g. the comdirect API PDF)
docs/reference/*.pdf
