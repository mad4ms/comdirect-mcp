COMDIRECT_USERNAME=your_username
COMDIRECT_PASSWORD=your_password
COMDIRECT_CLIENT_ID=your_client_id
COMDIRECT_CLIENT_SECRET=your_client_secret

# Optional MCP server settings
# COMDIRECT_MCP_PUSH_TAN_WAIT=30          # seconds to wait for the app approval if the client cannot show a confirmation dialog
# COMDIRECT_MCP_UNMASK_IBANS=false        # set to true to return counterparty IBANs unmasked
# COMDIRECT_MCP_MAX_DOCUMENT_BYTES=10485760
